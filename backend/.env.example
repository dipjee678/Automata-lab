# Copy this file to backend/.env and fill in the values.
# NEVER commit .env and NEVER put the service-role key in the frontend.

PORT=4000

# --- Supabase (leave all three empty to run in local JSON mode) ---------------
SUPABASE_URL=
# Project Settings -> API -> "anon public" key
SUPABASE_ANON_KEY=
# Project Settings -> API -> "service_role" key (server only: it bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- Local mode ---------------------------------------------------------------
# Secret for signing session tokens. If empty, a random one is generated and
# stored in backend/data/jwt-secret.
JWT_SECRET=
# Create demo accounts on first start (local mode only).
SEED_ON_START=true
# Password given to the seeded demo accounts.
SEED_PASSWORD=automata-demo-1

# --- General ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to false to let only admins create teacher accounts.
ALLOW_TEACHER_SIGNUP=true
# One-click demo sign-in buttons on the login page: any of student,teacher.
# Default: both in local mode, none with Supabase. Leave empty to hide them.
# DEMO_LOGINS=student,teacher
